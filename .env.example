# Praktika runtime configuration template, for example /etc/praktika/praktika.env on a Linux
# server. The active values are a server profile (Ollama for the minutes model, a vLLM speech
# server for English, Arabic off, pilot mode on), plus the other keys at their defaults (active or
# commented out). The comments give the allowed values, and the default wherever the value here
# differs from it. docs/DEPLOYMENT.md describes a server installation.
# Praktika reads exactly one env file: the one PRAKTIKA_ENV_FILE names (on a server, export
# PRAKTIKA_ENV_FILE=/etc/praktika/praktika.env), or else .env inside the default data directory; a
# .env in the working directory is never read. If PRAKTIKA_ENV_FILE names a file that is missing or
# unreadable, every command refuses to start; so does every command when PRAKTIKA_ENV_FILE is unset
# and the default location cannot be read (for example when sudo -E keeps the caller's home
# directory), with an error saying to export PRAKTIKA_ENV_FILE. praktika doctor warns when the named
# file sets no PRAKTIKA_ variable. Prefix is PRAKTIKA_; an unknown key in this file is a start-up error. No
# secrets belong here: PRAKTIKA_VAULT_KEY, PRAKTIKA_LLM_TOKEN and HF_TOKEN are read from the
# process environment only and are never persisted. Keys with an empty value must be commented out,
# not left empty.

PRAKTIKA_MODE=local                        # local | service. Service mode is the on-prem server behind your gateway.
PRAKTIKA_PILOT=true                        # Enforces pilot scope: Internal classification only, exclusions refused.
PRAKTIKA_ALLOW_DRAFT_EXPORT=false          # draft (unapproved) export also needs --allow-draft; never true in the pilot
PRAKTIKA_DATA_DIR=/var/lib/praktika        # SQLite, audio, audit.jsonl (0700). Default: $XDG_DATA_HOME/praktika, else ~/.local/share/praktika (per account).
PRAKTIKA_MODELS_DIR=/srv/praktika-models   # models.yaml and the registered weights (see `praktika models register`). Default: ~/praktika-models.
# PRAKTIKA_PROMPTS_DIR=/path/to/prompts    # Prompt files, versioned under prompts/<version>/ (default: the checkout).
PRAKTIKA_PROMPT_VERSION=v1                 # Prompt set used for generation; hashed into provenance.
# PRAKTIKA_GLOSSARY_PATH=/path/to/glossary.yaml   # Your organisation's terms, Arabic variants, STT misrenderings (default: the checkout's example glossary).

PRAKTIKA_ALLOWED_HOSTS=["localhost","127.0.0.1"]   # JSON list. Egress allow-list (glob); service adds the gateway FQDN.

PRAKTIKA_LLM_PROVIDER=ollama               # ollama | openai_compat | fake (fake needs PRAKTIKA_PILOT_SMOKE=true)
PRAKTIKA_LLM_BASE_URL=http://127.0.0.1:11434   # Host must match PRAKTIKA_ALLOWED_HOSTS.
PRAKTIKA_LLM_MODEL=qwen2.5:14b             # Minutes model (Ollama tag or vLLM model name).
PRAKTIKA_LLM_FALLBACK_MODEL=qwen2.5:14b    # Used above LLM_LONG_TRANSCRIPT_TOKENS. Default llama3.1:8b, which this profile does not install; doctor does not check it, so name a model that is present.
PRAKTIKA_LLM_NUM_CTX=32768                 # Context window; Ollama default of 2048 silently truncates.
PRAKTIKA_LLM_LONG_TRANSCRIPT_TOKENS=60000  # Threshold for degrading to the fallback model.
PRAKTIKA_LLM_FULL_CONTEXT_MAX_TOKENS=16000 # Single-pass generation up to this size; map-reduce above.
PRAKTIKA_LLM_TIMEOUT_S=600                 # Per-call HTTP timeout in seconds.

PRAKTIKA_STT_EN=http                       # http | fake. http = the vLLM speech server at STT_HTTP_URL; fake = a placeholder for tests. The default (mlx_whisper, Apple silicon) and faster_whisper (CUDA) run in-process and are meant for development machines.
PRAKTIKA_STT_AR=none                       # none | mlx_cohere | mlx_whisper_full | faster_whisper_full | http | fake. none (the default) = Arabic off: every chunk is decoded as English, and --lang ar-mixed is refused (exit 2) before the consent script. Every other value is development-only.
PRAKTIKA_STT_HTTP_URL=http://127.0.0.1:8801   # Speech server endpoint; host must be allow-listed. Default: unset (comment it out when no speech server is used).
PRAKTIKA_STT_LID_THRESHOLD=0.9             # Language-ID confidence for routing each chunk between the English and Arabic engines. Used only when the Arabic path is on (in every --lang mode); unused while STT_AR=none.

PRAKTIKA_DIARIZE=false                     # Enable diarisation only after your data protection officer's position is recorded.
PRAKTIKA_DIARIZE_BACKEND=none              # pyannote | fake | none

PRAKTIKA_REVIEW_HOST=127.0.0.1             # Review UI bind address; local mode refuses anything else.
PRAKTIKA_REVIEW_PORT=8793                  # Review UI port.
# PRAKTIKA_CAPTURE_TEAM_ID=                # macOS capture helper (--source sck) only; unused on Linux, leave it commented out.

PRAKTIKA_RETENTION_AUDIO_HOURS={"internal":24,"confidential":72,"restricted":0}      # Hard max audio life; audio also goes at approval or discard (at the next retention run).
PRAKTIKA_RETENTION_TRANSCRIPT_DAYS={"internal":14,"confidential":14,"restricted":7}  # After approval; in any case at most 60 days (30 restricted) after the transcript was first stored, a maximum fixed in code.
PRAKTIKA_RETENTION_DRAFT_DAYS={"internal":30,"confidential":30,"restricted":14}      # Unapproved drafts: after approval, or after the latest draft of a meeting never approved.

PRAKTIKA_AUDIT_SINK=jsonl                  # jsonl = the hash-chained audit.jsonl only | stdout = audit.jsonl plus a copy in audit-forward.jsonl for the SIEM shipper to tail (nothing goes to standard output)
PRAKTIKA_IDENTITY_PROVIDER=session         # session (the account the user logged in with) | oidc | fake (needs PRAKTIKA_PILOT_SMOKE=true)
# Service mode only (identity_provider=oidc); hosts must be allow-listed.
# PRAKTIKA_OIDC_ISSUER=https://login.acme.test/tenant/v2.0
# PRAKTIKA_OIDC_AUDIENCE=api://praktika
# PRAKTIKA_OIDC_JWKS_URL=https://login.acme.test/tenant/discovery/keys
# PRAKTIKA_PILOT_SMOKE=false               # true only for the README smoke test: allows the fake LLM and identity.
