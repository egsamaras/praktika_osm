{# One line per citation. The engine runs with trim_blocks, so a line that ends in a block tag
   loses its line break: each citation after the first starts with an explicit one instead. An
   item's citations hang off its own line only when it has some, so an item without citations
   adds no blank line (a blank line turns the whole list loose), and a topic's citations follow
   an "Evidence:" line, so Markdown does not nest them under the topic's last key point. #}
{% macro cite(refs) %}
{% for r in refs %}
{% if not loop.first %}{{ "\n" }}{% endif %}  - [{{ r.id }} {{ r.time }} {{ r.speaker }}] {% if r.arabic %}<bdi>“{{ r.quote }}”</bdi>{% else %}“{{ r.quote }}”{% endif %}
{% if r.gloss %}{{ "\n" }}    - Gloss (EN): {{ r.gloss }}{% endif %}
{% endfor %}
{% endmacro %}
{% macro actions_list(items) %}
{% for a in items %}
- **{{ a.id }}** {{ a.description }} — owner: {{ a.owner }} ({{ a.owner_confidence }}); due: {{ a.due }}
{{ cite(a.refs) }}
{% else %}
_None._
{% endfor %}
{% endmacro %}
**Classification: {{ classification }}**{% if private %} · **PRIVATE — not indexed, not for circulation**{% endif %}


{% if banner %}
> **{{ banner }}**

{% endif %}
